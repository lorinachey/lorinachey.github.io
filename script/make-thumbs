#!/usr/bin/env python3
"""Generate small square thumbnails for news items.

Sources are already in the repo; this only downsizes them. Re-runnable: it
overwrites whatever is in assets/img/thumbs/.
"""
import pathlib, sys
from PIL import Image, ImageOps

SIZE = 176  # rendered at 88px, doubled for high-density screens
SRC = pathlib.Path("assets/img")
OUT = SRC / "thumbs"
OUT.mkdir(parents=True, exist_ok=True)

pairs = [
    ("telluride-neuromorphic-ai-2026/award-ceremony-signal-2026-07-17-210228.jpeg", "telluride.jpg"),
    ("cu-article-snippet.png",            "cu-article.jpg"),
    ("ndseg-fellowship.png",              "ndseg.jpg"),
    ("lorin-cosmo-aspens.JPG",            "about-the-author.jpg"),
    ("scene-sense-diffusion-models.PNG",  "scenesense.jpg"),
]

for src, dst in pairs:
    p = SRC / src
    if not p.exists():
        print("missing:", p, file=sys.stderr); continue
    im = Image.open(p)
    im = ImageOps.exif_transpose(im).convert("RGB")
    # Crop to a centred square, then downsize.
    im = ImageOps.fit(im, (SIZE, SIZE), Image.LANCZOS, centering=(0.5, 0.4))
    out = OUT / dst
    im.save(out, "JPEG", quality=80, optimize=True, progressive=True)
    print(f"{src} ({p.stat().st_size//1024}KB) -> {dst} ({out.stat().st_size//1024}KB)")
